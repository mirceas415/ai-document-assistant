%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial, sans-serif","fontSize":"16px","primaryColor":"#f3f4f6","primaryTextColor":"#111111","primaryBorderColor":"#4b5563","lineColor":"#4b5563","secondaryColor":"#ffffff","tertiaryColor":"#e5e7eb","clusterBkg":"#fafafa","clusterBorder":"#6b7280"},"flowchart":{"curve":"linear","nodeSpacing":28,"rankSpacing":38,"htmlLabels":true}}}%%
flowchart TB
    Analysis[Technical PDF Analysis Result] --> Classification[Page Classification]
    Classification --> Scanned{Page is Scanned?}

    Scanned -- No --> Native[Keep Native Page Path<br/>No Automatic OCR]
    Scanned -- Yes --> Render[Render Page Locally<br/><i>PDFium</i>]
    Render --> OCR[Recognize Text Locally<br/><i>Tesseract</i>]
    OCR --> Usable{Usable OCR text?}
    Usable -- Yes --> OcrText[Use OCR Page Text]
    Usable -- No --> Diagnostic[Record Empty / Failed Result<br/>No text for that scanned page]

    Native --> Merge[Merge Page Results<br/>in Original Document Order]
    OcrText --> Merge
    Diagnostic --> Merge
    Merge --> Unified[Unified Document Representation]

    Mixed[Mixed PDF<br/>native pages + OCR pages] -. combines in .-> Merge

    classDef stage fill:#e5e7eb,stroke:#374151,stroke-width:1.4px,color:#111111;
    classDef local fill:#ffffff,stroke:#374151,stroke-width:1.4px,color:#111111;
    classDef decision fill:#fafafa,stroke:#374151,stroke-width:1.4px,color:#111111;
    classDef note fill:#fafafa,stroke:#6b7280,stroke-dasharray:5 3,color:#111111;
    class Analysis,Classification,Native,Merge,Unified stage;
    class Render,OCR,OcrText,Diagnostic local;
    class Scanned,Usable decision;
    class Mixed note;
