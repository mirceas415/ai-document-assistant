flowchart LR
    subgraph Intake[Document Intake]
        direction TB
        Upload[Document Upload] --> Store[Validation / Storage]
        Store --> Queue[Queued Processing]
    end

    subgraph Extraction[Local Format Processing]
        direction TB
        Format{Document format?}
        Format -- PDF --> Analysis[Technical PDF Analysis]
        Analysis --> NativePdf[Native PDF Extraction<br/><i>PdfPig</i>]
        NativePdf --> Scanned{Any page classified<br/>Scanned?}
        Scanned -- Yes --> Render[PDF Rendering<br/><i>PDFium, local</i>]
        Render --> OCR[OCR<br/><i>Tesseract, local</i>]
        OCR --> Merge[Page-aware Merge<br/>in source order]
        Scanned -- No --> Merge

        Format -- DOCX --> NativeDocx[Native DOCX Extraction<br/><i>OpenXML</i>]
        NativeDocx --> Merge
    end

    subgraph Searchable[Enrichment and Persistence]
        direction TB
        Normalize[Normalization]
        Normalize --> Understanding[Document Understanding<br/><i>non-blocking enrichment</i>]
        Understanding --> Chunking[Chunking]
        Chunking --> Embeddings[Embedding Generation]
        Embeddings --> Persist[(Persisted Searchable Representation<br/>PostgreSQL + pgvector)]
    end

    Intake --> Extraction
    Extraction --> Searchable

    classDef stage fill:#e5e7eb,stroke:#374151,stroke-width:1.4px,color:#111111;
    classDef local fill:#ffffff,stroke:#374151,stroke-width:1.4px,color:#111111;
    classDef decision fill:#fafafa,stroke:#374151,stroke-width:1.4px,color:#111111;
    class Upload,Store,Queue,Analysis,Merge,Normalize,Understanding,Chunking,Embeddings stage;
    class NativePdf,NativeDocx,Render,OCR local;
    class Format,Scanned decision;
