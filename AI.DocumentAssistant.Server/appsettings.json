{
  "Chunking": {
    "TargetTokens": 700,
    "MaximumTokens": 900,
    "OverlapTokens": 100,
    "MinimumTokens": 100
  },
  "OpenAI": {
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 1536,
    "BatchSize": 32,
    "AnswerModel": "gpt-5.6-luna",
    "RerankingModel": "gpt-5.6-sol",
    "DocumentUnderstandingModel": "gpt-5.6-luna",
    "AnswerRetrievalTopK": 8,
    "MaxContextTokens": 6000,
    "MaxAnswerTokens": 700,
    "SourceExcerptCharacters": 500,
    "RecentConversationMessageCount": 6,
    "MaxConversationContextTokens": 1200
  },
  "HybridRetrieval": {
    "VectorCandidateCount": 30,
    "LexicalCandidateCount": 30,
    "MetadataDocumentCandidateCount": 20,
    "ReciprocalRankConstant": 60,
    "VectorWeight": 1.0,
    "LexicalWeight": 1.0,
    "MetadataWeight": 0.35,
    "ExactIdentifierMultiplier": 1.5
  },
  "Retrieval": {
    "Reranking": {
      "Enabled": true,
      "CandidateCount": 18,
      "MaxCandidateCount": 30,
      "MaxInputTokens": 12000,
      "MaxCandidateTokens": 700,
      "TimeoutSeconds": 30
    }
  },
  "DocumentNormalization": {
    "HeaderCandidateLineCount": 15,
    "FooterCandidateLineCount": 15,
    "MinimumPageOccurrenceRatio": 0.6,
    "MinimumPageCountForBoilerplateDetection": 3,
    "MinimumCandidateBlockLength": 40,
    "MinimumLocalCandidateBlockLength": 160,
    "MaximumCandidateLength": 4000,
    "MaximumBlockBoundaryLineOffset": 2,
    "EnablePageNumberRemoval": true,
    "EnableWordBreakRepair": true
  },
  "Ocr": {
    "Enabled": true,
    "TessDataPath": "tessdata",
    "Languages": "ron+eng",
    "RenderDpi": 300,
    "MaxCandidatePages": 200,
    "MaxRenderedPixels": 25000000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
